<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/exit_panel"
    android:layout_width="640dp" android:layout_height="wrap_content" android:layout_gravity="center"
    android:orientation="vertical" android:padding="@dimen/space_large" android:background="@drawable/panel_background" android:visibility="gone">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/exit_title" android:textSize="@dimen/channel_text_size"
        android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_large" android:orientation="vertical">
        <Button android:id="@+id/keep_watching" style="@style/TVButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/keep_watching"
            android:nextFocusUp="@id/keep_watching" android:nextFocusDown="@id/exit_app" />
        <Button android:id="@+id/exit_app" style="@style/TVButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_medium"
            android:nextFocusUp="@id/keep_watching" android:nextFocusDown="@id/exit_app" android:text="@string/exit_app" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_medium" android:text="@string/dialog_help"
        android:textSize="@dimen/help_text_size" android:textColor="@color/text_secondary" />
</LinearLayout>
