<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:focusable="true" android:focusableInTouchMode="true">
    <androidx.media3.ui.PlayerView android:id="@+id/player_view"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:descendantFocusability="blocksDescendants" android:focusable="false"
        app:use_controller="false" app:resize_mode="fit" app:surface_type="surface_view" />
    <View android:id="@+id/scrim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/scrim" android:visibility="gone" />
    <FrameLayout android:id="@+id/safe_content" android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:id="@+id/channel_overlay" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start" android:orientation="vertical"
            android:padding="@dimen/space_medium" android:background="@drawable/panel_background">
            <TextView android:id="@+id/channel_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_primary" android:textSize="@dimen/channel_text_size"
                android:accessibilityLiveRegion="polite" android:fontFamily="sans-serif-medium" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/remote_help" android:textColor="@color/text_secondary" android:textSize="@dimen/help_text_size" />
        </LinearLayout>
        <TextView android:id="@+id/loading" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:padding="@dimen/space_large" android:background="@drawable/panel_background"
            android:text="@string/loading_channel" android:textColor="@color/text_primary" android:textSize="@dimen/channel_text_size" />
        <include layout="@layout/channel_menu" />
        <include layout="@layout/settings_menu" />
        <include layout="@layout/playback_error" />
        <include layout="@layout/exit_confirmation" />
        <TextView android:id="@+id/channel_input" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:padding="@dimen/space_medium"
            android:background="@drawable/panel_background" android:textColor="@color/text_primary"
            android:textSize="@dimen/channel_text_size" android:fontFamily="sans-serif-medium"
            android:focusable="false" android:accessibilityLiveRegion="polite" android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
