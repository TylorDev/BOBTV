<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/error_panel"
    android:layout_width="640dp" android:layout_height="wrap_content" android:layout_gravity="center"
    android:orientation="vertical" android:padding="@dimen/space_large" android:background="@drawable/panel_background" android:visibility="gone">
    <TextView android:id="@+id/error_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/channel_unavailable" android:textSize="@dimen/channel_text_size"
        android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_medium" android:text="@string/channel_unavailable_help"
        android:textSize="@dimen/help_text_size" android:textColor="@color/text_secondary" />
    <Button android:id="@+id/accept_change" style="@style/TVButton" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_large" android:text="@string/accept_change" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_medium" android:text="@string/failure_help"
        android:textSize="@dimen/help_text_size" android:textColor="@color/text_secondary" />
</LinearLayout>
